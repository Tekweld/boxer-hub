{
  "functions": {
    "api/sync-zen-clientes.js": { "maxDuration": 60 },
    "api/sync-estoque.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/sync-zen-clientes", "schedule": "0 6 * * *" },
    { "path": "/api/sync-estoque", "schedule": "0 10-22 * * 1-5" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/$1.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src fonts.gstatic.com; connect-src 'self' *.supabase.co brasilapi.com.br *.brasilapi.com.br viacep.com.br *.viacep.com.br; img-src 'self' *.supabase.co *.sharepoint.com data:;" }
      ]
    }
  ]
}
